# ============================================================
# BAŞKENT ENERJİ — Telegram Bot .env.example
# Gerçek değerleri .env dosyasına kopyalayarak girin.
# BU DOSYAYI DEĞİŞTİRMEYİN — SADECE ÖRNEK
# ============================================================

# === Telegram Bot Tokenları ===
TELEGRAM_BOT_TOKEN=YOUR_MAIN_BOT_TOKEN_HERE
OPERATOR_BOT_TOKEN=YOUR_OPERATOR_BOT_TOKEN_HERE
RUBLE_BOT_TOKEN=YOUR_RUBLE_BOT_TOKEN_HERE

# === Veritabanı (MSSQL Express) ===
DB_SERVER=localhost\SQLEXPRESS
DB_NAME=mtturkey_exchange
DB_USER=sa
DB_PASSWORD=YOUR_SQL_PASSWORD_HERE

# === API ===
BASKENT_API_URL=https://api.baskentenerji.com/api/v1
BASKENT_API_USERNAME=YOUR_API_USERNAME
BASKENT_API_PASSWORD=YOUR_API_PASSWORD

# === Flask (Operator Panel) ===
FLASK_SECRET_KEY=YOUR_64_CHAR_HEX_SECRET_HERE

# === Başkent Enerji Sistem ID'leri ===
BASKENT_DEFAULT_VAULT_ID=YOUR_VAULT_UUID_HERE
BASKENT_USDT_CURRENCY_ID=YOUR_USDT_CURRENCY_UUID_HERE
BASKENT_RUBLE_CURRENCY_ID=YOUR_RUBLE_CURRENCY_UUID_HERE
